StartScreen {
    align: center middle;
}

#dialog {
    grid-size: 2 4;
    grid-gutter: 1 2;
    grid-rows: 1fr 3 3 3;
    padding: 0 1;
    width: 60;
    height: 15;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

#status {
    column-span: 2;
    row-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

.switch {
    column-span: 2;
    .label {
        height: 3;
        content-align: center middle;
        width: auto;
        margin-left: 2;
    }
}

Button {
    width: 1fr;
}

Chessboard {
    width: 88;
    height: 40;

    .chessboard--white-square {
        background: #A5BAC9;
    }

    .chessboard--black-square {
        background: #004578;
    }

    .chessboard--action-square {
        background: #808080;
    }
}
